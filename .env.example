# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES (.env.local)
# ==============================================================================

# --- 1. Web3 / Reown AppKit (Required for WalletConnect modal) ---
# Get your Project ID at: https://cloud.reown.com (free)
NEXT_PUBLIC_REOWN_PROJECT_ID=

# --- 2. Firebase App Check (Protection against bots/scrapers) ---
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_KEY=

# For Local Development: App Check Debug Token (auto-enabled in dev mode if empty)
# Set to true or paste token registered in Firebase Console -> App Check -> Apps -> Debug tokens
# NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=true

# --- 4. Cryptographic Server Handshake ---
# Secret key used to sign HMAC-SHA256 handshake tickets (generate any random 32+ char string)
HANDSHAKE_SECRET=

# Optional: Point handshake requests to Cloudflare Worker instead of local Next.js route
# NEXT_PUBLIC_HANDSHAKE_API_URL=https://vectorizerr-backend.<your-subdomain>.workers.dev/api/handshake/authorize

# --- 5. Backend Worker Integration (Transaction Verification & Credit Refresh) ---
# Base URL of deployed Cloudflare Worker (e.g. https://api.vectorizerr.workers.dev)
NEXT_PUBLIC_BACKEND_URL=https://api.vectorizerr.workers.dev
# URL of your deployed Cloudflare Worker for on-demand credit verification
NEXT_PUBLIC_REFRESH_CREDITS_FUNCTION_URL=https://api.vectorizerr.workers.dev/api/refresh-credits
# URL of support endpoint (defaults to ${NEXT_PUBLIC_BACKEND_URL}/api/support)
NEXT_PUBLIC_SUPPORT_API_URL=https://api.vectorizerr.workers.dev/api/support
# Shared secret for authenticating requests sent to vectorizerr-backend in x-api-secret header
API_SECRET=

# --- 7. Build Settings ---
# Set OUTPUT_MODE=export for Cloudflare Pages static export
OUTPUT_MODE=export

# --- 8. App & Feature Configuration ---
# Public URL of the frontend deployment (defaults to https://vectorizerr.pages.dev)
NEXT_PUBLIC_APP_URL=https://vectorizerr.pages.dev

# --- 9. Debug Mode ---
# Set to true to use testnets instead of mainnet chains for development/testing
# When enabled, the app uses: Sepolia, BSC Testnet, Polygon Amoy, Base Sepolia, Arbitrum Sepolia
NEXT_PUBLIC_DEBUG_MODE=false
# Secret to access testnet configurations and wallets from the backend worker
NEXT_PUBLIC_TESTNET_SECRET=
