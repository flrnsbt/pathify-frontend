# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES (.env.local)
# ==============================================================================

# --- 1. Web3 / Reown AppKit (Required for WalletConnect modal) ---
# Get your Project ID at: https://cloud.reown.com (free)
NEXT_PUBLIC_REOWN_PROJECT_ID=

# --- 2. Firebase App Check (Protection against bots/scrapers) ---
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_KEY=

# For Local Development: App Check Debug Token (auto-enabled in dev mode if empty)
# Set to true or paste token registered in Firebase Console -> App Check -> Apps -> Debug tokens
# NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=true

# --- 4. Cryptographic Server Handshake ---
# Secret key used to sign HMAC-SHA256 handshake tickets (generate any random 32+ char string)
HANDSHAKE_SECRET=

# Shared secret for authenticating requests sent to vectorizerr-backend in x-api-secret header
API_SECRET=

# --- 7. Build Settings ---
# Standalone mode supports API routes and works with OpenNext/Cloudflare deployment
# OUTPUT_MODE=export

# --- 8. App & Feature Configuration ---
# Public URL of the frontend deployment (defaults to https://vectorizerr.pages.dev)
NEXT_PUBLIC_APP_URL=https://vectorizerr.pages.dev


# Secret to access testnet configurations and wallets from the backend worker
TESTNET_SECRET=
