# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES (.env.local)
# ==============================================================================

# --- 1. Web3 / Reown AppKit (Required for WalletConnect modal) ---
# Get your Project ID at: https://cloud.reown.com (free)
NEXT_PUBLIC_REOWN_PROJECT_ID=b56e18d47c72ab683b10814fe9495694

# --- 2. Firebase Configuration ---
# Firebase project credentials (already preconfigured in config.ts, but can be overridden here)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAJ1he5OrzyuuLy9S3Q6efQmRCQsDV5O-s
NEXT_PUBLIC_FIREBASE_PROJECT_ID=vectorizerr

# --- 3. Firebase App Check (Protection against bots/scrapers) ---
# For Production: Google reCAPTCHA v3 or Enterprise Site Key
# Create key at: https://www.google.com/recaptcha/admin or Firebase Console -> App Check
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_KEY=

# For Local Development: App Check Debug Token (auto-enabled in dev mode if empty)
# Set to true or paste token registered in Firebase Console -> App Check -> Apps -> Debug tokens
# NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=true

# Set to true to strictly block requests without App Check tokens in /api/handshake
ENFORCE_APPCHECK=false

# --- 4. Cryptographic Server Handshake ---
# Secret key used to sign HMAC-SHA256 handshake tickets (generate any random 32+ char string)
HANDSHAKE_SECRET=vz-cryptographic-handshake-secret-key-prod-994

# Optional: Point handshake requests to Cloudflare Worker instead of local Next.js route
# NEXT_PUBLIC_HANDSHAKE_API_URL=https://vectorizerr-backend.<your-subdomain>.workers.dev/api/handshake/authorize

# --- 5. Backend Worker Integration (Transaction Verification & Credit Refresh) ---
# URL of your deployed Cloudflare Worker for on-demand credit verification
NEXT_PUBLIC_REFRESH_CREDITS_FUNCTION_URL=https://vectorizerr-backend.<your-subdomain>.workers.dev/api/refresh-credits

# --- 6. Recipient Payment Wallets (Optional) ---
# If empty, the app automatically loads wallet addresses from `wallets.json`
# NEXT_PUBLIC_PAYMENT_WALLETS=

# --- 7. Build Settings ---
# Set OUTPUT_MODE=export for Cloudflare Pages static export
OUTPUT_MODE=export
